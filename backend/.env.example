PORT=3000

# Microsoft SQL Server (use with schema-sqlserver.sql in SSMS)
SQLSERVER_SERVER=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=your_password
SQLSERVER_DATABASE=inventory_db
# Local dev: trust server certificate (set false in production with proper certs)
SQLSERVER_TRUST_CERT=true
SQLSERVER_ENCRYPT=true

JWT_SECRET=change-this-to-a-long-random-string-in-production
